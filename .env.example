# --- Django Settings ---
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=paste-your-secure-django-secret-key-here
# Use * for ease of testing on AWS IP, or replace with your ec2 instance IP / domain name
ALLOWED_HOSTS=*
# CSRF setting for proxy/AWS host (e.g., http://*)
CSRF_TRUSTED_ORIGINS=http://*,https://*

# --- Database Settings (PostgreSQL) ---
DB_NAME=documind_db
DB_USER=postgres
DB_PASSWORD=your_secure_database_password
DB_HOST=postgres
DB_PORT=5432

# --- Redis Settings ---
REDIS_URL=redis://redis:6379/0

# --- Celery Settings ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- pgAdmin Settings ---
PGADMIN_DEFAULT_EMAIL=admin@documind.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password
